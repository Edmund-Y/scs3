{
  "name": "korea-restaurant",
  "version": "3.2.2",
  "description": "경로식당 이용자 관리 프로그램",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 > nul && electron .",
    "build": "electron-builder build --win --publish always"
  },
  "build": {
    "productName": "경로식당",
    "appId": "com.welfare.korea-restaurant",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "경로식당",
      "include": "installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Edmund-Y",
      "repo": "scs3",
      "releaseType": "release"
    }
  },
  "author": "DongYoun, Lee <admin@moonlight.one>",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.3",
    "serialport": "^13.0.0",
    "sql.js": "^1.11.0"
  }
}
